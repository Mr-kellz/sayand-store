{
  "functions": {
    "predeploy": [
      "node tools/check-release.cjs"
    ],
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "tools/**",
      "**/*.zip",
      "**/*.MP4",
      "**/*.mp4",
      "**/*.md",
      "*-Install.txt",
      "START-HERE.txt",
      "package.json",
      "package-lock.json",
      "index.js",
      "firebase-debug.log*",
      "database.rules.json",
      "INSTALL-ORDER-SECURITY.txt",
      "INSTALL-CHECKOUT-SECURITY.txt",
      "**/*export*.json",
      "**/*snapshot*.json",
      "**/*backup*.json",
      "**/*.log",
      "INSTALL.txt",
      "tests/**",
      "**/*.cjs",
      "VALIDATION.txt",
      "**/functions/**",
      "product-*.html",
      "collection-*.html",
      "sitemap.xml",
      "storage.rules",
      "rollback/**",
      "product.html",
      "js/auth.js"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/product{,.html}",
        "function": {
          "functionId": "cataloguePages",
          "region": "us-central1"
        }
      },
      {
        "source": "/product-**",
        "function": {
          "functionId": "cataloguePages",
          "region": "us-central1"
        }
      },
      {
        "source": "/collection-**",
        "function": {
          "functionId": "cataloguePages",
          "region": "us-central1"
        }
      },
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "cataloguePages",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/catalogue-routes",
        "function": {
          "functionId": "cataloguePages",
          "region": "us-central1"
        }
      },
      {
        "source": "/newsletter-confirm",
        "function": {
          "functionId": "confirmNewsletter",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/public-editorial",
        "function": {
          "functionId": "publicEditorial",
          "region": "us-central1"
        }
      }
    ],
    "predeploy": [
      "node tools/check-release.cjs"
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
