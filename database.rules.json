        },
        "items": {
          ".validate": "(auth != null && auth.uid === 'MS15g8h5ELPmMcuBijhEC7loGws2') || newData.hasChildren()"
        },
        "$other": {
          ".validate": "(auth != null && auth.uid === 'MS15g8h5ELPmMcuBijhEC7loGws2') || data.exists()"
        }
      }
    },
    "adminOrderIndex": {
      ".read": "auth != null && auth.uid === 'MS15g8h5ELPmMcuBijhEC7loGws2'",
