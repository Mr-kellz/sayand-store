        },
        "status": {
          ".write": "auth != null && data.parent().child('userId').val() === auth.uid && newData.isString() && ((newData.val() === 'Canceled (By User)' && (data.val() === 'Pending' || data.val() === 'Verifying' || data.val() === 'Processing' || data.val() === 'Paid')) || (newData.val() === 'Return Requested' && (data.val() === 'Shipped' || data.val() === 'Delivered')))",
          ".validate": "(auth != null && auth.uid === 'MS15g8h5ELPmMcuBijhEC7loGws2') || newData.isString()"
        },
        "timestamp": {
          ".validate": "(auth != null && auth.uid === 'MS15g8h5ELPmMcuBijhEC7loGws2') || (newData.isNumber() && newData.val() >= 0)"
        },
        "totalAmount": {
          ".validate": "(auth != null && auth.uid === 'MS15g8h5ELPmMcuBijhEC7loGws2') || (newData.isNumber() && newData.val() >= 0)"
        },
        "discountAmount": {
